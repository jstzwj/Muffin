<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Muffin"
    Manufacturer="Muffin"
    Version="$(var.MuffinVersion)"
    UpgradeCode="b5e2b3a0-1234-4d5e-8f9a-1b2c3d4e5f6a"
    Language="1033"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Muffin is already installed." />

    <!-- Publishes the install folder to ARP so the setup UI (and anything
         else) can locate Muffin.exe without a Burn→MSI property round-trip.
         A plain Property would write the literal "[INSTALLFOLDER]"; SetProperty
         schedules the type-51 action that expands it at install time. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="both" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Interactive install wizard with a feature tree so users can opt out of
         the shell-integration pieces. WixUI_FeatureTree shows: Welcome →
         Customize (feature checkboxes) → Ready to Install. No license file or
         install-folder prompt is required. -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Muffin">
        <Directory Id="PlatformsDir" Name="platforms" />
        <Directory Id="StylesDir" Name="styles" />
        <Directory Id="ImageformatsDir" Name="imageformats" />
        <Directory Id="TlsDir" Name="tls" />
        <Directory Id="NetworkinformationDir" Name="networkinformation" />
      </Directory>
    </StandardDirectory>

    <!-- The application itself is required (Absent=disallow); the two shell-
         integration features below default to installed and can be unchecked
         in the Customize step of the wizard, or toggled later from the app's
         Files preferences page (which writes the same HKCU\SOFTWARE\Classes
         keys the per-user components below install). -->
    <Feature Id="MainFeature" Title="Muffin" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="MuffinMainFiles" />
      <ComponentGroupRef Id="MuffinPlatformsPlugins" />
      <ComponentGroupRef Id="MuffinStylesPlugins" />
      <ComponentGroupRef Id="MuffinImageformatsPlugins" />
      <ComponentGroupRef Id="MuffinTlsPlugins" />
      <ComponentGroupRef Id="MuffinNetworkinformationPlugins" />
      <ComponentRef Id="ApplicationShortcut" />

      <Feature Id="ShellContextMenu" Title="Explorer context menu" Level="1"
               Description="Adds &quot;Open with Muffin&quot; to the right-click menu for Markdown files, folders, and folder backgrounds.">
        <ComponentGroupRef Id="MuffinContextMenu" />
      </Feature>

      <Feature Id="FileAssociations" Title="Associate Markdown files" Level="1"
               Description="Registers Muffin as an editor for .md, .markdown, .mdx, .mkd, and .mdown files so it appears in &quot;Open with&quot;. The first launch then offers to make it the default editor.">
        <ComponentGroupRef Id="MuffinFileAssociations" />
      </Feature>
    </Feature>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Muffin">
        <Component Id="ApplicationShortcut" Guid="c1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c">
          <Shortcut Id="ApplicationStartMenuShortcut"
            Name="Muffin"
            Target="[INSTALLFOLDER]Muffin.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder"
            Directory="ApplicationProgramsFolder"
            On="uninstall" />
          <RegistryValue Root="HKCU"
            Key="Software\Muffin"
            Name="installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

  </Package>

  <!-- Main directory files: exe, dlls, qt.conf -->
  <Fragment>
    <ComponentGroup Id="MuffinMainFiles" Directory="INSTALLFOLDER">
      <Component Id="MuffinExe" Guid="d2e3f4a5-b6c7-4d8e-9f0a-1b2c3d4e5f6a">
        <File Id="MuffinExeFile" Source="$(var.DistDir)/Muffin.exe" KeyPath="yes" />
      </Component>
      <!-- Headless mermaid CLI (mmdc-compatible flag subset). Sits beside
           Muffin.exe so the bundled Qt DLLs and qt.conf resolve for it too. -->
      <Component Id="MuffinMmdc" Guid="a3b4c5d6-e7f8-4a9b-8c0d-2e3f4a5b6c7d">
        <File Id="MuffinMmdcFile" Source="$(var.DistDir)/muffin-mmdc.exe" KeyPath="yes" />
      </Component>
      <Component Id="Qt6Core" Guid="*">
        <File Id="Qt6CoreDll" Source="$(var.DistDir)/Qt6Core.dll" />
      </Component>
      <Component Id="Qt6Gui" Guid="*">
        <File Id="Qt6GuiDll" Source="$(var.DistDir)/Qt6Gui.dll" />
      </Component>
      <Component Id="Qt6Svg" Guid="*">
        <File Id="Qt6SvgDll" Source="$(var.DistDir)/Qt6Svg.dll" />
      </Component>
      <Component Id="Qt6Widgets" Guid="*">
        <File Id="Qt6WidgetsDll" Source="$(var.DistDir)/Qt6Widgets.dll" />
      </Component>
      <Component Id="Qt6PrintSupport" Guid="*">
        <File Id="Qt6PrintSupportDll" Source="$(var.DistDir)/Qt6PrintSupport.dll" />
      </Component>
      <Component Id="Qt6Network" Guid="*">
        <File Id="Qt6NetworkDll" Source="$(var.DistDir)/Qt6Network.dll" />
      </Component>
      <Component Id="QtConf" Guid="c7d8e9f0-a1b2-4c3d-e4f5-a6b7c8d9e0f1">
        <File Id="QtConfFile" Source="$(var.DistDir)/qt.conf" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Qt platforms plugins -->
  <Fragment>
    <ComponentGroup Id="MuffinPlatformsPlugins" Directory="PlatformsDir">
      <Component Id="QWindows" Guid="*">
        <File Id="QWindowsDll" Source="$(var.DistDir)/platforms/qwindows.dll" />
      </Component>
      <Component Id="QDirect2D" Guid="*">
        <File Id="QDirect2DDll" Source="$(var.DistDir)/platforms/qdirect2d.dll" />
      </Component>
      <Component Id="QMinimal" Guid="*">
        <File Id="QMinimalDll" Source="$(var.DistDir)/platforms/qminimal.dll" />
      </Component>
      <Component Id="QOffscreen" Guid="*">
        <File Id="QOffscreenDll" Source="$(var.DistDir)/platforms/qoffscreen.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Qt styles plugins -->
  <Fragment>
    <ComponentGroup Id="MuffinStylesPlugins" Directory="StylesDir">
      <Component Id="QModernWindowsStyle" Guid="*">
        <File Id="QModernWindowsStyleDll" Source="$(var.DistDir)/styles/qmodernwindowsstyle.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Qt imageformats plugins -->
  <Fragment>
    <ComponentGroup Id="MuffinImageformatsPlugins" Directory="ImageformatsDir">
      <Component Id="QGif" Guid="*">
        <File Id="QGifDll" Source="$(var.DistDir)/imageformats/qgif.dll" />
      </Component>
      <Component Id="QIco" Guid="*">
        <File Id="QIcoDll" Source="$(var.DistDir)/imageformats/qico.dll" />
      </Component>
      <Component Id="QSvg" Guid="*">
        <File Id="QSvgDll" Source="$(var.DistDir)/imageformats/qsvg.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Qt TLS plugins -->
  <Fragment>
    <ComponentGroup Id="MuffinTlsPlugins" Directory="TlsDir">
      <Component Id="QSchannelBackend" Guid="*">
        <File Id="QSchannelBackendDll" Source="$(var.DistDir)/tls/qschannelbackend.dll" />
      </Component>
      <Component Id="QOpenSslBackend" Guid="*">
        <File Id="QOpenSslBackendDll" Source="$(var.DistDir)/tls/qopensslbackend.dll" />
      </Component>
      <Component Id="QCertOnlyBackend" Guid="*">
        <File Id="QCertOnlyBackendDll" Source="$(var.DistDir)/tls/qcertonlybackend.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Qt NetworkInformation plugins -->
  <Fragment>
    <ComponentGroup Id="MuffinNetworkinformationPlugins" Directory="NetworkinformationDir">
      <Component Id="QNetworkListManager" Guid="*">
        <File Id="QNetworkListManagerDll" Source="$(var.DistDir)/networkinformation/qnetworklistmanager.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- Per-user Explorer "Open with Muffin" verbs. Each component owns one
       Muffin-authored subtree of HKCU\SOFTWARE\Classes so uninstall removes
       exactly what we added (other apps' verbs are left untouched). Commands
       quote the installed exe; folder backgrounds use %V (the open folder),
       while files and folder selections use %1. -->
  <Fragment>
    <ComponentGroup Id="MuffinContextMenu" Directory="TARGETDIR">
      <Component Id="CtxFile_md" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5001">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.md\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.md\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.md\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; &quot;%1&quot;" />
      </Component>
      <Component Id="CtxFile_markdown" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5002">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.markdown\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.markdown\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.markdown\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; &quot;%1&quot;" />
      </Component>
      <Component Id="CtxFile_mdx" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5003">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdx\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdx\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdx\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; &quot;%1&quot;" />
      </Component>
      <Component Id="CtxFile_mkd" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5004">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mkd\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mkd\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mkd\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; &quot;%1&quot;" />
      </Component>
      <Component Id="CtxFile_mdown" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5005">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdown\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdown\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdown\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; &quot;%1&quot;" />
      </Component>
      <Component Id="CtxDirectory" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5006">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Directory\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Directory\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Directory\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; --folder &quot;%1&quot;" />
      </Component>
      <Component Id="CtxDirectoryBackground" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5007">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Directory\Background\shell\Muffin" Type="string" Value="Open with Muffin" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Directory\Background\shell\Muffin\Icon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Directory\Background\shell\Muffin\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; --folder &quot;%V&quot;" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- File association: registers the Muffin.md ProgID and lists it under each
       extension's OpenWithProgids so Muffin shows up in "Open with" and can be
       set as the default. OpenWithProgids values are authored as empty
       REG_BINARY (WiX has no REG_NONE authoring); the Windows shell keys off
       the value name, so this is accepted. The launch-prompt flag is read by
       Muffin.exe at first run to redirect to the Default Apps page. -->
  <Fragment>
    <ComponentGroup Id="MuffinFileAssociations" Directory="TARGETDIR">
      <Component Id="MuffinProgId" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5008">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Muffin.md" Type="string" Value="Muffin Markdown Document" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Muffin.md" Name="FriendlyAppName" Type="string" Value="Muffin" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Muffin.md\DefaultIcon" Type="string" Value="[INSTALLFOLDER]Muffin.exe,0" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Muffin.md\shell\open" Type="string" Value="Open" />
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\Muffin.md\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]Muffin.exe&quot; &quot;%1&quot;" />
      </Component>
      <Component Id="Assoc_md" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d5009">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.md\OpenWithProgids" Name="Muffin.md" Type="binary" Value="" KeyPath="yes" />
      </Component>
      <Component Id="Assoc_markdown" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d500a">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.markdown\OpenWithProgids" Name="Muffin.md" Type="binary" Value="" KeyPath="yes" />
      </Component>
      <Component Id="Assoc_mdx" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d500b">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdx\OpenWithProgids" Name="Muffin.md" Type="binary" Value="" KeyPath="yes" />
      </Component>
      <Component Id="Assoc_mkd" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d500c">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mkd\OpenWithProgids" Name="Muffin.md" Type="binary" Value="" KeyPath="yes" />
      </Component>
      <Component Id="Assoc_mdown" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d500d">
        <RegistryValue Root="HKCU" Key="SOFTWARE\Classes\.mdown\OpenWithProgids" Name="Muffin.md" Type="binary" Value="" KeyPath="yes" />
      </Component>
      <Component Id="AssocPromptDefault" Guid="e94b1f8a-3c61-4d72-9e0a-1a2b3c4d500e">
        <RegistryValue Root="HKCU" Key="Software\Muffin\Muffin\integration" Name="promptDefaultOnLaunch" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
