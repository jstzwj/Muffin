file(REAL_PATH "${BINARY_DIR}" build_root)
cmake_path(ABSOLUTE_PATH OUTPUT_DIR NORMALIZE OUTPUT_VARIABLE output)
cmake_path(GET output PARENT_PATH parent)
file(REAL_PATH "${parent}" parent)
cmake_path(GET output FILENAME name)
if(NOT parent STREQUAL build_root OR NOT name STREQUAL "portable" OR IS_SYMLINK "${output}")
  message(FATAL_ERROR "Portable staging must be the non-linked 'portable' child of the build directory.")
endif()
if(EXISTS "${output}/Data")
  message(FATAL_ERROR "Portable staging contains personal data. Move it elsewhere before rebuilding: ${output}/Data")
endif()
if(NOT EXISTS "${DIST_DIR}/Muffin.exe" OR EXISTS "${DIST_DIR}/Data")
  message(FATAL_ERROR "Portable input must be a clean Windows distribution without a user profile.")
endif()
file(REAL_PATH "${DIST_DIR}" input)
cmake_path(IS_PREFIX output "${input}" NORMALIZE input_under_output)
cmake_path(IS_PREFIX input "${output}" NORMALIZE output_under_input)
if(input_under_output OR output_under_input)
  message(FATAL_ERROR "Portable input and staging directories must not overlap.")
endif()
file(REMOVE_RECURSE "${output}")
file(MAKE_DIRECTORY "${output}")
file(COPY "${DIST_DIR}/" DESTINATION "${output}")
file(WRITE "${output}/Muffin.portable" "Muffin portable profile marker. Keep this file beside Muffin.exe.\n")
file(WRITE "${output}/PORTABLE.txt"
  "Muffin Portable\n\nSettings, drafts, themes and operation backups stay in the Data folder beside Muffin.exe.\nKeep Muffin.portable and Data together when moving this copy. No system file associations are changed.\nDo not run from a read-only folder. Portable copies are updated by unpacking a new archive while preserving Data.\nUser documents and exported files remain at the locations you choose.\n")
