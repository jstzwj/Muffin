<RCC>
  <qresource prefix="/icons/statusbar">
    <file alias="sidebar-collapse.svg">icons/statusbar/sidebar-collapse.svg</file>
    <file alias="sidebar-expand.svg">icons/statusbar/sidebar-expand.svg</file>
    <file alias="source-code.svg">icons/statusbar/source-code.svg</file>
    <file alias="split-view.svg">icons/statusbar/split-view.svg</file>
  </qresource>
  <qresource prefix="/icons/table-toolbar">
    <file alias="resize.svg">icons/table-toolbar/resize.svg</file>
    <file alias="align-left.svg">icons/table-toolbar/align-left.svg</file>
    <file alias="align-center.svg">icons/table-toolbar/align-center.svg</file>
    <file alias="align-right.svg">icons/table-toolbar/align-right.svg</file>
    <file alias="more.svg">icons/table-toolbar/more.svg</file>
    <file alias="delete.svg">icons/table-toolbar/delete.svg</file>
  </qresource>
  <qresource prefix="/icons/image">
    <file alias="image-placeholder.svg">icons/image/image-placeholder.svg</file>
    <file alias="image-broken.svg">icons/image/image-broken.svg</file>
  </qresource>
  <qresource prefix="/icons/ui">
    <file alias="check.svg">icons/ui/check.svg</file>
    <file alias="radio-dot.svg">icons/ui/radio-dot.svg</file>
    <file alias="pin.svg">icons/ui/pin.svg</file>
    <file alias="close.svg">icons/ui/close.svg</file>
    <file alias="plus.svg">icons/ui/plus.svg</file>
    <file alias="chevron-down.svg">icons/ui/chevron-down.svg</file>
    <file alias="read-only.svg">icons/ui/read-only.svg</file>
    <file alias="scroll-linked.svg">icons/ui/scroll-linked.svg</file>
    <file alias="scroll-unlinked.svg">icons/ui/scroll-unlinked.svg</file>
    <file alias="split-layout.svg">icons/ui/split-layout.svg</file>
  </qresource>
  <qresource prefix="/app">
    <file alias="muffin.png">../resources/app-icons/muffin-256.png</file>
  </qresource>
</RCC>
