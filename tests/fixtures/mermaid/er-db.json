{
  "upstream": {
    "package": "mermaid",
    "version": "11.16.0",
    "grammar": {
      "url": "https://raw.githubusercontent.com/mermaid-js/mermaid/mermaid%4011.16.0/packages/mermaid/src/diagrams/er/parser/erDiagram.jison"
    },
    "notes": "Fixture corpus for the native er::ErDiagram parser. Each case lists the expected entity/relationship surface (counts + field-level detail); the test asserts against er::ErDiagram::parse(source).data(). Source syntax follows src/mermaid/erdiagram/IMPLEMENTATION_SPEC.md section 3. Cardinality enum names match ErCardinality (ExactlyOne/ZeroOrOne/OneOrMore/ZeroOrMore); keyType names match ErAttributeKeyType (None/PrimaryKey/ForeignKey/UniqueKey)."
  },
  "cases": [
    {
      "id": "cardinality-types",
      "source": "erDiagram\nA ||--|| B\nC |o--o| D\nE }|--|{ F\nG }o--o{ H",
      "entities": [
        { "id": "A" },
        { "id": "B" },
        { "id": "C" },
        { "id": "D" },
        { "id": "E" },
        { "id": "F" },
        { "id": "G" },
        { "id": "H" }
      ],
      "relationships": [
        { "entityA": "A", "entityB": "B", "cardA": "ExactlyOne", "cardB": "ExactlyOne", "identifying": true, "label": "" },
        { "entityA": "C", "entityB": "D", "cardA": "ZeroOrOne", "cardB": "ZeroOrOne", "identifying": true, "label": "" },
        { "entityA": "E", "entityB": "F", "cardA": "OneOrMore", "cardB": "OneOrMore", "identifying": true, "label": "" },
        { "entityA": "G", "entityB": "H", "cardA": "ZeroOrMore", "cardB": "ZeroOrMore", "identifying": true, "label": "" }
      ]
    },
    {
      "id": "entity-attributes-keys",
      "source": "erDiagram\nCUSTOMER {\n  string name PK \"primary name key\"\n  int age\n  bigint account_id FK\n  string email UK \"unique email\"\n}",
      "entities": [
        {
          "id": "CUSTOMER",
          "attributes": 4,
          "attributeDetails": [
            { "type": "string", "name": "name", "keyType": "PrimaryKey", "comment": "primary name key" },
            { "type": "int", "name": "age", "keyType": "None", "comment": "" },
            { "type": "bigint", "name": "account_id", "keyType": "ForeignKey", "comment": "" },
            { "type": "string", "name": "email", "keyType": "UniqueKey", "comment": "unique email" }
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "relationship-with-label",
      "source": "erDiagram\nCUSTOMER ||--o{ ORDER : places",
      "entities": [
        { "id": "CUSTOMER" },
        { "id": "ORDER" }
      ],
      "relationships": [
        { "entityA": "CUSTOMER", "entityB": "ORDER", "cardA": "ExactlyOne", "cardB": "ZeroOrMore", "identifying": true, "label": "places" }
      ]
    },
    {
      "id": "entity-alias",
      "source": "erDiagram\nENTITY \"Display Name\"\nUSER \"Application User\" {\n  string id PK\n}",
      "entities": [
        { "id": "ENTITY", "name": "Display Name", "attributes": 0 },
        {
          "id": "USER",
          "name": "Application User",
          "attributes": 1,
          "attributeDetails": [
            { "type": "string", "name": "id", "keyType": "PrimaryKey", "comment": "" }
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "acc-title",
      "source": "erDiagram\naccTitle: ER Model\nA ||--|| B",
      "accTitle": "ER Model",
      "entities": [
        { "id": "A" },
        { "id": "B" }
      ],
      "relationships": [
        { "entityA": "A", "entityB": "B", "cardA": "ExactlyOne", "cardB": "ExactlyOne", "identifying": true, "label": "" }
      ]
    },
    {
      "id": "non-identifying-roles",
      "source": "erDiagram\nA \"roleA\" }o--o{ \"roleB\" B : has\nCUSTOMER }|..|{ DELIVERY-ADDRESS : uses",
      "entities": [
        { "id": "A" },
        { "id": "B" },
        { "id": "CUSTOMER" },
        { "id": "DELIVERY-ADDRESS" }
      ],
      "relationships": [
        { "entityA": "A", "entityB": "B", "cardA": "ZeroOrMore", "cardB": "ZeroOrMore", "identifying": true, "roleA": "roleA", "roleB": "roleB", "label": "has" },
        { "entityA": "CUSTOMER", "entityB": "DELIVERY-ADDRESS", "cardA": "OneOrMore", "cardB": "OneOrMore", "identifying": false, "label": "uses" }
      ]
    },
    {
      "id": "optional-type-question-mark",
      "source": "erDiagram\nCUSTOMER {\n  string? nickname\n  int age\n}",
      "entities": [
        {
          "id": "CUSTOMER",
          "attributes": 2,
          "attributeDetails": [
            { "type": "string?", "name": "nickname", "keyType": "None", "comment": "" },
            { "type": "int", "name": "age", "keyType": "None", "comment": "" }
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "backtick-attribute-words",
      "source": "erDiagram\nCUSTOMER {\n  `string list` `favorite tags`\n  `int count` `open, orders`\n}",
      "entities": [
        {
          "id": "CUSTOMER",
          "attributes": 2,
          "attributeDetails": [
            { "type": "string list", "name": "favorite tags", "keyType": "None", "comment": "" },
            { "type": "int count", "name": "open, orders", "keyType": "None", "comment": "" }
          ]
        }
      ],
      "relationships": []
    }
  ]
}
