  "preprocess": [
    {
      "id": "plain",
      "source": "graph LR\r\nA[\"x\"] --> B\r\n",
      "expected": {
        "code": "graph LR\nA[\"x\"] --> B\n",
        "config": {}
      }
    },
    {
      "id": "comments",
      "source": "  %% first\n%% second\nsequenceDiagram\nA->>B: hi\n%% tail",
      "expected": {
        "code": "sequenceDiagram\nA->>B: hi\n",
        "config": {}
      }
    },
    {
      "id": "html-attributes",
      "source": "flowchart LR\nA[<span class=\"x\" data-v=\"a b\">Hi</span>]",
      "expected": {
        "code": "flowchart LR\nA[<span class='x' data-v='a b'>Hi</span>]",
        "config": {}
      }
    },
    {
      "id": "frontmatter",
      "source": "---\ntitle: Example\ndisplayMode: compact\nconfig:\n  theme: forest\n  flowchart:\n    curve: basis\n---\ngantt\ntitle Work",
      "expected": {
        "code": "gantt\ntitle Work",
        "title": "Example",
        "config": {
          "theme": "forest",
          "flowchart": {
            "curve": "basis"
          },
          "gantt": {
            "displayMode": "compact"
          }
        }
      }
    },
    {
      "id": "indented-frontmatter",
      "source": "  ---\n  title: Indented\n  config:\n    theme: dark\n  ---\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "title": "Indented",
        "config": {
          "theme": "dark"
        }
      }
    },
    {
      "id": "init",
      "source": "%%{init: {\"theme\": \"dark\", \"flowchart\": {\"curve\": \"linear\"}}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "theme": "dark",
          "flowchart": {
            "curve": "linear"
          }
        }
      }
    },
    {
      "id": "legacy-config-init",
      "source": "%%{initialize: {\"config\": {\"curve\": \"step\"}}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "flowchart": {
            "curve": "step"
          }
        }
      }
    },
    {
      "id": "multiple-and-wrap",
      "source": "%%{init: {\"theme\": \"forest\"}}%%\n%%{init: {\"flowchart\": {\"curve\": \"basis\"}}}%%\n%%{wrap}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "theme": "forest",
          "flowchart": {
            "curve": "basis"
          },
          "wrap": true
        }
      }
    },
    {
      "id": "sanitize",
      "source": "%%{init: {\"theme\": \"dark\", \"unknownKey\": 1, \"__proto__\": {\"x\": 1}}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "theme": "dark",
          "unknownKey": 1
        }
      }
    },
    {
      "id": "json-schema-scalars",
      "source": "---\ntitle: yes\nconfig:\n  darkMode: true\n  handDrawnSeed: 12\n---\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "title": "yes",
        "config": {
          "darkMode": true,
          "handDrawnSeed": 12
        }
      }
    },
    {
      "id": "quoted-scalars",
      "source": "---\ntitle: \"true\"\nconfig:\n  darkMode: \"false\"\n---\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "title": "true",
        "config": {
          "darkMode": "false"
        }
      }
    },
    {
      "id": "numeric-title",
      "source": "---\ntitle: 42\n---\npie\n\"A\" : 1",
      "expected": {
        "code": "pie\n\"A\" : 1",
        "title": "42",
        "config": {}
      }
    },
    {
      "id": "empty-title",
      "source": "---\ntitle: \"\"\n---\ninfo",
      "expected": {
        "code": "info",
        "config": {}
      }
    },
    {
      "id": "non-map-frontmatter",
      "source": "---\n- one\n- two\n---\ninfo",
      "expected": {
        "code": "info",
        "config": {}
      }
    },
    {
      "id": "frontmatter-closing-indent-guard",
      "source": "---\ntitle: Outer\nvalue: |\n  inside\n  ---\n---\ninfo",
      "expected": {
        "code": "info",
        "title": "Outer",
        "config": {}
      }
    },
    {
      "id": "carriage-returns",
      "source": "%% comment\rgraph LR\rA-->B\r",
      "expected": {
        "code": "graph LR\nA-->B\n",
        "config": {}
      }
    },
    {
      "id": "directive-is-not-comment",
      "source": "%%{wrap}%%\n%% ordinary\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "wrap": true
        }
      }
    },
    {
      "id": "single-quoted-init",
      "source": "%%{init: {'theme': 'neutral'}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "theme": "neutral"
        }
      }
    },
    {
      "id": "malformed-init-json",
      "source": "%%{init: {broken: true}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {}
      }
    },
    {
      "id": "multiple-init-sanitizes",
      "source": "%%{init: {\"theme\": \"dark\", \"unknownKey\": 1}}%%\n%%{init: {\"flowchart\": {\"curve\": \"linear\"}}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "theme": "dark",
          "flowchart": {
            "curve": "linear"
          }
        }
      }
    },
    {
      "id": "multiple-init-full-sanitizer",
      "source": "%%{init: {\"themeCSS\": \"a {\", \"radar\": {\"graticuleOpacity\": 0.5}, \"themeVariables\": {\"primaryColor\": \"#fff\", \"unknownThemeKey\": \"red\", \"lineColor\": \"url(x)\"}, \"treeView\": {\"filenameIcons\": {\"README\": \"logos:readme\", \"bad\": \"x y\"}}}}%%\n%%{init: {\"theme\": \"dark\"}}%%\nflowchart LR\na-->b",
      "expected": {
        "code": "flowchart LR\na-->b",
        "config": {
          "themeCSS": "{ /* ERROR: Unbalanced CSS */ }",
          "radar": {
            "graticuleOpacity": 0.5
          },
          "themeVariables": {
            "primaryColor": "#fff",
            "lineColor": "url(x)"
          },
          "treeView": {
            "filenameIcons": {
              "README": "logos:readme"
            }
          },
          "theme": "dark"
        }
      }
    },
    {
      "id": "frontmatter-init-merge",
      "source": "---\nconfig:\n  theme: forest\n  flowchart:\n    curve: basis\n---\n%%{init: {\"theme\": \"dark\", \"flowchart\": {\"defaultRenderer\": \"dagre-wrapper\"}}}%%\ngraph LR\na-->b",
      "expected": {
        "code": "graph LR\na-->b",
        "config": {
          "theme": "dark",
          "flowchart": {
            "curve": "basis",
            "defaultRenderer": "dagre-wrapper"
          }
        }
      }
    },
    {
      "id": "comment-without-final-newline",
      "source": "flowchart LR\na-->b\n%% tail",
      "expected": {
        "code": "flowchart LR\na-->b\n",
        "config": {}
      }
    }
  ]
}
