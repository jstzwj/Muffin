{
  "upstream": {
    "package": "mermaid",
    "version": "11.16.0"
  },
  "cases": [
    {
      "id": "no-header",
      "source": "This is not a mermaid diagram at all.",
      "upstreamError": {
        "stage": "detector",
        "line": 1,
        "column": 1,
        "summary": "No diagram type detected matching given configuration for text: This is not a mermaid diagram at all."
      },
      "expectedCategory": "MissingHeader",
      "expectedStage": "detector",
      "expectedCode": "missing-header",
      "expectedLine": 1,
      "expectedColumn": 1
    },
    {
      "id": "unclosed-subgraph",
      "source": "flowchart TB\nsubgraph S[Group]\nA --> B",
      "upstreamError": {
        "stage": "parser",
        "line": 4,
        "column": 1,
        "summary": "Parse error on line 4:"
      },
      "expectedCategory": "UnclosedSubgraph",
      "expectedStage": "parser",
      "expectedCode": "unclosed-subgraph",
      "expectedLine": 3,
      "expectedColumn": 8
    },
    {
      "id": "unexpected-end",
      "source": "flowchart TB\nend",
      "upstreamError": {
        "stage": "parser",
        "line": 1,
        "column": 13,
        "summary": "Parse error on line 2:"
      },
      "expectedCategory": "UnexpectedEnd",
      "expectedStage": "parser",
      "expectedCode": "unexpected-end",
      "expectedLine": 2,
      "expectedColumn": 1
    },
    {
      "id": "linkstyle-oob",
      "source": "flowchart TB\nA --> B\nlinkStyle 5 stroke:red",
      "upstreamError": {
        "stage": "semantic",
        "line": 0,
        "column": 0,
        "summary": "Cannot set properties of undefined (setting 'style')"
      },
      "expectedCategory": "LinkStyleBounds",
      "expectedStage": "semantic",
      "expectedCode": "link-style-bounds",
      "expectedLine": 3,
      "expectedColumn": 11
    },
    {
      "id": "bad-classdef",
      "source": "flowchart TB\nclassDef x",
      "upstreamError": {
        "stage": "parser",
        "line": 2,
        "column": 10,
        "summary": "Parse error on line 2:"
      },
      "expectedCategory": "InvalidDirective",
      "expectedStage": "parser",
      "expectedCode": "missing-token",
      "expectedLine": 2,
      "expectedColumn": 11
    },
    {
      "id": "text-limit",
      "source": "flowchart TB\nA --> B",
      "upstreamError": null,
      "expectedCategory": "LimitExceeded",
      "expectedStage": "resource",
      "expectedCode": "limit-exceeded",
      "expectedLine": 0,
      "expectedColumn": 0,
      "options": {
        "maxTextSize": 8
      }
    },
    {
      "id": "edge-limit",
      "source": "flowchart TB\nA --> B\nC --> D",
      "upstreamError": null,
      "expectedCategory": "LimitExceeded",
      "expectedStage": "resource",
      "expectedCode": "limit-exceeded",
      "expectedLine": 3,
      "expectedColumn": 0,
      "options": {
        "maxEdges": 1
      }
    },
    {
      "id": "vertex-limit",
      "source": "flowchart TB\nA --> B",
      "upstreamError": null,
      "expectedCategory": "LimitExceeded",
      "expectedStage": "resource",
      "expectedCode": "limit-exceeded",
      "expectedLine": 2,
      "expectedColumn": 0,
      "limits": {
        "maxVertices": 1
      }
    },
    {
      "id": "subgraph-depth-limit",
      "source": "flowchart TB\nsubgraph S1\nsubgraph S2\nend\nend",
      "upstreamError": null,
      "expectedCategory": "LimitExceeded",
      "expectedStage": "resource",
      "expectedCode": "limit-exceeded",
      "expectedLine": 3,
      "expectedColumn": 0,
      "limits": {
        "maxSubgraphDepth": 1
      }
    },
    {
      "id": "nodeid-length-limit",
      "source": "flowchart TB\nABC",
      "upstreamError": null,
      "expectedCategory": "LimitExceeded",
      "expectedStage": "resource",
      "expectedCode": "limit-exceeded",
      "expectedLine": 2,
      "expectedColumn": 0,
      "limits": {
        "maxNodeIdLength": 2
      }
    }
  ]
}
