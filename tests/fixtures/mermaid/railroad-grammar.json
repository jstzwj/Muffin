      "id": "direct-canonical",
      "source": "railroad-beta\ntitle Direct grammar\naccTitle: Direct accessible\naccDescr {First line\n  Second line}\nroot = sequence(terminal(\"if\"), nonterminal(\"condition\"), optional(terminal(\"else\")), choice(terminal(\"yes\"), terminal(\"no\")), zeroOrMore(special(\"token\")), oneOrMore(nonterminal(\"item\")));\nescaped = terminal(\"line\\nquote\\\"\");",
      "accepted": true,
      "database": {
        "title": "Direct grammar",
        "accTitle": "Direct accessible",
        "accDescr": "First line\nSecond line",
        "rules": [
          {
            "name": "root",
            "definition": {
              "type": "sequence",
              "elements": [
                {
                  "type": "terminal",
                  "value": "if"
                },
                {
                  "type": "nonterminal",
                  "name": "condition"
                },
                {
                  "type": "optional",
                  "element": {
                    "type": "terminal",
                    "value": "else"
                  }
                },
                {
                  "type": "choice",
                  "alternatives": [
                    {
                      "type": "terminal",
                      "value": "yes"
                    },
                    {
                      "type": "terminal",
                      "value": "no"
                    }
                  ]
                },
                {
                  "type": "repetition",
                  "element": {
                    "type": "special",
                    "text": "token"
                  },
                  "min": 0,
                  "max": null
                },
                {
                  "type": "repetition",
                  "element": {
                    "type": "nonterminal",
                    "name": "item"
                  },
                  "min": 1,
                  "max": null
                }
              ]
            }
          },
          {
            "name": "escaped",
            "definition": {
              "type": "terminal",
              "value": "line\nquote\""
            }
          }
        ]
      }
