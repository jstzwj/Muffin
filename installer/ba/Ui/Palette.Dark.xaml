<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mirror of the light palette using the logo's dark ink as the surface. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
    <SolidColorBrush x:Key="CardBrush" Color="#282828" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#363636" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#1F1F1F" />

    <SolidColorBrush x:Key="AccentBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#282828" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#484848" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#333333" />

    <SolidColorBrush x:Key="TrackBrush" Color="#3C3C3C" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#3A2224" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />

    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3C3C3C" />

</ResourceDictionary>
